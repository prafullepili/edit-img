{
  "name": "luma-image-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write src scripts vite.config.js",
    "check": "node scripts/check-layers.mjs && node scripts/check-photo.mjs && node scripts/check-design.mjs && node scripts/check-preview.mjs && node scripts/check-ids.mjs && node scripts/check-slider-gestures.mjs && node scripts/check-group-deletion.mjs",
    "build:pages": "vite build --mode pages"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@reduxjs/toolkit": "^2.8.2",
    "@tailwindcss/vite": "^4.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-redux": "^9.2.0",
    "tailwindcss": "^4.3.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "vite": "^6.3.5",
    "prettier": "^3.0.0"
  },
  "overrides": {
    "@imgly/background-removal": {
      "zod": "$zod"
    }
  }
}
